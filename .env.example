# Server
PORT=8787
NODE_ENV=production

# Auth (CHANGE THIS!)
DASHBOARD_PASSWORD=yourpasswordhere
SESSION_SECRET=generate-a-random-string-here

# Read-only agent connector (REST API under /api/v1/portfolio). When set, external
# tools can read normalized portfolio state with `Authorization: Bearer <token>`.
# Leave BLANK to disable the connector entirely (fails closed). Generate with e.g.
#   openssl rand -hex 32
PULSE_API_TOKEN=

# Solana RPC (get free at helius.dev)
HELIUS_API_KEY=

# Jupiter API (get free at portal.jup.ag — needed for Solana holdings + prices)
JUPITER_API_KEY=

# Database
DATABASE_PATH=./data/pulse.db

# Background wallet auto-refresh interval in minutes (also when a net-worth
# snapshot is recorded). Default 720 = every 12h. 0 = disabled (manual only).
WALLET_REFRESH_MINUTES=720

# Delay (ms) between wallets during a refresh, to avoid RPC rate limits
WALLET_REFRESH_GAP_MS=5000

# Max concurrent Solana RPC calls (throttle to avoid 429s; calls retry w/ backoff)
SOLANA_RPC_CONCURRENCY=3

# EVM token auto-discovery (Ethereum + Base via free Blockscout API, no key).
# Discovered tokens must be worth at least this many USD to be kept (filters out
# spam/airdrop dust). Watchlisted/tracked tokens are always kept regardless.
EVM_MIN_TOKEN_USD=1
# Safety cap on how many discovered tokens to price per chain (spam-flood guard).
EVM_MAX_DISCOVERED=250

# Suspect-drop guard: if a wallet refresh returns less than this fraction of its
# previous value, treat it as a transient RPC/pricing glitch — keep the old value
# and skip the net-worth snapshot (unless the low value repeats). 0.5 = 50%.
WALLET_SUSPECT_DROP_RATIO=0.5

# How long (ms) to cache DexScreener token prices, so a refresh cycle doesn't
# re-query shared tokens and get rate-limited. Default 120000 = 2 min.
DEXSCREENER_CACHE_MS=120000

# Scam-pool guards for DexScreener fallback pricing:
# Pairs with less than this much USD liquidity can't price anything (fabricated
# prices hide behind a few dollars of fake liquidity).
DEXSCREENER_MIN_LIQ_USD=1000
# A token's implied value (units × price) may not exceed this multiple of the
# pricing pair's liquidity — beyond that the "value" could never be realized
# (airdropped mega-bags priced by thin pools). Rejected tokens stay unpriced.
DEXSCREENER_MAX_VALUE_TO_LIQ=2

# Cross-verification of upstream prices (Jupiter etc.) against liquidity-verified
# DexScreener pools. Positions worth at least this much get verified:
PRICE_VERIFY_MIN_VALUE_USD=1000
# If the upstream price deviates from the verified price by more than this factor
# (either direction), the verified price is used instead.
PRICE_VERIFY_MAX_DEVIATION=3
